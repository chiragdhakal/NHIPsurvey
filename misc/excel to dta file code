sections <- lapply(sections, function(df) {
  if ("ID" %in% names(df)) {
    df[!df$ID %in% drop_ids, , drop = FALSE]
  } else {
    df
  }
})

sections$section0 <- sections$section0 %>%
  group_by(psu) %>%
  mutate(
    hhld = row_number(),
    hhid = paste0(psu, "-", hhld)
  ) %>%
  ungroup()

uid_map <- sections$section0 %>% select(uid, hhld)

sections <- lapply(sections, function(df) {
  if ("uid" %in% names(df)) {
    df %>%
      select(-any_of("hhld")) %>%
      left_join(uid_map, by = "uid") %>%
      relocate(hhld, .after = 5)
  } else {
    df
  }
})

list2env(sections, .GlobalEnv)

